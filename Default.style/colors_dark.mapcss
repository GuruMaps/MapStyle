// roads of all kinds
@color_small_road: #666666;
@color_small_road_casing: #4C4C4C;
@color_pedestrian: #323232;
@color_pedestrian_casing: #545454;
@color_bridge: #6C7175;
@color_railroad_tunnel: #6C7175AA;
@color_cycleway_dashes: #2638C1;
@color_footway_area: #3B2713;
@color_footway_casing: #00000030;
@color_road_construction: #AD5F0B;
@color_dashes_casing: #00000030;
@color_track_dashes: #BAA492;
@color_track_casing: #00000088;
@if Style == Outdoor
    @color_footway_dashes: #AE7469;
    @if SubStyle == Bike
        @color_cycleway_dashes: #4050C9;
        @color_track_dashes: #7980B7;
    @endif
    @color_path_dashes: @color_track_dashes;
    @color_motorway_casing: @color_small_road_casing;
    @color_motorway: @color_small_road;
    @color_trunk_casing: @color_small_road_casing;
    @color_trunk: @color_small_road;
    @color_primary_casing: @color_small_road_casing;
    @color_primary: @color_small_road;
    @color_secondary_casing: @color_small_road_casing;
    @color_secondary: @color_small_road;
    @color_tertiary: @color_small_road;
@else
    @color_footway_dashes: #94615A;
    @color_path_dashes: @color_footway_dashes;
    @color_motorway_casing: #D85615;
    @color_motorway: #CB4400;
    @color_trunk_casing: #C65816;
    @color_trunk: #BA4600;
    @color_primary_casing: #D88115;
    @color_primary: #CB7100;
    @color_secondary_casing: #C69A16;
    @color_secondary: #BA8C00;
    @color_tertiary: @color_small_road;
@endif

@color_railway: #1E4810;
@color_railway_dashes: #7F7F7F;
@color_railway_disused: #606060AA;

@color_icon_ford: #2A98EF;
@color_text_ford: #2A98EF;
@color_icon_fountain: @color_icon_ford;

@color_rock: #565656;

// Road number shields in road sign colours, a step darker than in daylight: the tint colours shield.svg, the engine picks
// white or dark text for contrast (dark text above luminance 0.6, which keeps black numbers on yellow)
@color_shield_red: #A3111A;
@color_shield_green: #2A6E3C;
@color_shield_blue: #0B4A78;
@color_shield_yellow: #D4A000;
@color_shield_yellow_text: #1E1E1E;
@color_shield_white: #4A4A4A; // a dark grey plate instead of the white one, which glares on the dark map
@color_shield_orange: #D27A00; // Turkish otoyol
@color_shield_white_text: #FFFFFF;
@color_shield_gold_text: #FFC000; // Cyprus
@color_shield_uk_green: #0B5E33; // British and Irish primary routes: yellow numbers on green
@color_shield_uk_yellow: #F2C500;
@color_shield_plate_blue_text: #8CC0EE; // blue numbers on the grey plate (Turkish provincial roads)

// Route palette for mapColor(): OSM colour names of route relations, other colours snap to the nearest entry.
// The same Material hues as the POI icons, a step stronger so lines read on the map.
@route_palette: "red:#EF5350, orange:#FFA726, yellow:#FFD54F, green:#66BB6A, blue:#42A5F5, purple:#AB47BC, violet:#AB47BC, brown:#A1887F, grey:#A7AFB4, gray:#A7AFB4, black:#78909C, white:#ECEFF1, pink:#F06292";
// Translucent bands of hiking and bicycle routes under the ways: the same hues, light ones more opaque so all read alike
@route_band_palette: "red:#EF535070, orange:#FFA72670, yellow:#FFD54F80, green:#66BB6A80, blue:#42A5F570, purple:#AB47BC70, violet:#AB47BC70, brown:#A1887F90, grey:#A7AFB490, gray:#A7AFB490, black:#78909C90, white:#ECEFF180, pink:#F0629270";
