
line|z9-[route=ferry] {
    dashes: 6, 6;
    dashes-width: eval( zlinear(9, 1px,1pt,2pt ));
    dashes-color: @color_ferry_route;
    z-index: 2;
    details-enabled: true;
}

relation[type=route] {
    relation[route=ferry] {
        line|z9- {
            dashes: 6, 6;
            dashes-width: eval( zlinear(9, 1px,1pt,2pt ));
            dashes-color: @color_ferry_route;
            z-index: 2;
            details-enabled: true;
        }
    }
}

// Waymarked colour of a route relation: the way colour of osmc:symbol, else colour
@route_colour: any(listItem(relationTag('osmc:symbol'), 0, ":"), relationTag('colour'));
// Width of one route band from z13; neighbouring bands touch
@route_band_width: zlinear(13, 5pt,7pt,9pt,11pt);

@if Style == Outdoor
relation[type=route] {

@if SubStyle == Hike
    relation[route=hiking],
    relation[route=foot] {
        line|z9-12 {
            layer: 6;
            relation[network=lwn] {
                width: eval( zlinear(9, 1px,1pt,2pt,3pt,4pt ));
                color: #0000ff80; // blue
                z-index: 1;
                details-enabled: true;
            }
            relation[network=rwn] {
                width: eval( zlinear(9, 1pt,2pt,3pt,4pt ));
                color: #ab28ff; // violet
                z-index: 2;
                details-enabled: true;
            }
            relation[network=iwn],
            relation[network=nwn] {
                width: eval( zlinear(9, 2pt,3pt,3pt,4pt ));
                color: #df0000aa; // red
                z-index: 3;
                details-enabled: true;
            }
            relation[colour] {
                color: eval(mapColor(@route_palette, relationTag('colour'), @color_icon_transport));
            }
        }
        // Routes sharing a way run side by side in translucent outlines of their waymarked colours, so the way and its dashes stay visible;
        // the network colour stands in for unmarked ones and unreadable colours
        line|z13- {
            per-relation: true;
            outline-width: eval(@route_band_width);
            offset: eval(relationSlot() * @route_band_width);
            outline-color: eval(mapColor(@route_band_palette, any(@route_colour, "blue"), mapColor(@route_band_palette, "blue")));
            z-index: 1;
            details-enabled: true;
            relation[network=rwn] {
                outline-color: eval(mapColor(@route_band_palette, any(@route_colour, "purple"), mapColor(@route_band_palette, "purple")));
                z-index: 2;
            }
            relation[network=iwn],
            relation[network=nwn] {
                outline-color: eval(mapColor(@route_band_palette, any(@route_colour, "red"), mapColor(@route_band_palette, "red")));
                z-index: 3;
            }
        }
    }
@endif
@if SubStyle == Bike
    relation[route=bicycle] {
        line|z9-12 {
            layer: 6;
            relation[network=lcn] {
                width: eval( zlinear(9, 1px,1pt,2pt,3pt,4pt ));
                color: #0000ff80; // blue
                z-index: 1;
                details-enabled: true;
            }
            relation[network=rcn] {
                width: eval( zlinear(9, 1pt,2pt,3pt,4pt ));
                color: #ab28ff; // violet
                z-index: 2;
                details-enabled: true;
            }
            relation[network=icn],
            relation[network=ncn] {
                width: eval( zlinear(9, 2pt,3pt,3pt,4pt ));
                color: #df0000aa; // red
                z-index: 3;
                details-enabled: true;
            }
            relation[colour] {
                color: eval(mapColor(@route_palette, relationTag('colour'), @color_icon_transport));
            }
        }
        // Routes sharing a way run side by side in translucent outlines of their colours, so the way and its dashes stay visible;
        // the network colour stands in for routes without a readable one
        line|z13- {
            per-relation: true;
            outline-width: eval(@route_band_width);
            offset: eval(relationSlot() * @route_band_width);
            outline-color: eval(mapColor(@route_band_palette, any(@route_colour, "blue"), mapColor(@route_band_palette, "blue")));
            z-index: 1;
            details-enabled: true;
            relation[network=rcn] {
                outline-color: eval(mapColor(@route_band_palette, any(@route_colour, "purple"), mapColor(@route_band_palette, "purple")));
                z-index: 2;
            }
            relation[network=icn],
            relation[network=ncn] {
                outline-color: eval(mapColor(@route_band_palette, any(@route_colour, "red"), mapColor(@route_band_palette, "red")));
                z-index: 3;
            }
        }
    }
@endif

@if SubStyle != Car
    relation[route=subway] {
        // Metro lines side by side in palette colours, both directions of a line drawn once
        line|z11- {
            per-relation: true;
            layer: 6;
            width: eval( zlinear(11, 2pt,2pt,2.5pt,3pt,3.5pt ));
            offset: eval(relationSlot() * zlinear(11, 1.5pt,1.5pt,2pt,2.5pt,3pt ));
            color: eval(mapColor(@route_palette, relationTag('colour'), @color_icon_transport));
            linecap: round;
        }
    }
@endif

}
@endif

@if SelectedRelations
    @SelectedRelations {
        line|z9-12 {
            outline-width: eval( zlinear(9, 4pt,5pt,5pt,6pt ));
            outline-color: #ff000050;
        }
        line|z13- {
            width: eval( zlinear(9, 2pt,3pt,3pt,4pt ));
            color: #ff0000aa; // red
        }
    }
@endif
