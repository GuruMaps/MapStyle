@color_aeroway_runway: #F1F8FC;
@color_aeroway_runway_line: #BDBDBD;
@color_aeroway_apron: #DED0D5;
@color_pitch: #BCDFCD;
@color_swimming_pool: #6FB8E3;
@color_bridge: #CCC;
@color_barrier: #E6A176;
@color_hedge: #749933;
@color_grass: #C8DF9F; // l: -0.07
@color_quarry: #C4C2C2;
@color_hospital: #FCFCDC;
@color_private: #F79090;
@color_tunnel: #D0D0D0;
@color_national_park: #ACCB8A;
