@color_building_text: #77614A;
@color_entrance_text: #776147;
@color_public_transport_text: #383835;
@color_private_access_text: #8b100e;
@color_label_stroke: #FFFFFFEE;

@color_water_text: #0F4F80;
@color_water_stroke: #FFFFFFB3;
@color_aerialway_text: #000;
@color_shop_text: #5B3A05;
@color_sand_text: #72664B;
@color_landuse_residential_text: #5E574D;
@color_wetland_text: #1F3F64;
@color_wetland_stroke: #FFFFFF99;

@color_difficulty_novice: #008000;
@color_difficulty_easy: #0000FF;
@color_difficulty_intermediate: #FF0000;
@color_difficulty_expert: #000;
@color_difficulty_freeride: #FFA500;

// POI text keeps the icon hue, dark enough for 4.5:1 contrast on @color_ground
@color_icon_offices: #80C880; // same
@color_text_offices: #217524; // @color_icon_offices
@color_icon_stores: #64B5F6; // same
@color_text_stores: #036BA1; // @color_icon_stores
@color_icon_tourism: #4DB6AC; // same
@color_text_tourism: #2C6D67; // @color_icon_tourism
@color_icon_food: #FFA726; // same
@color_text_food: #A74901; // @color_icon_food
@color_icon_activity: #FF8A65; // same
@color_text_activity: #AE4421; // @color_icon_activity
@color_icon_health: #E57373; // same
@color_text_health: #AC4145; // @color_icon_health
@color_icon_transport: #90A4AE; // same
@color_icon_transport_private: #90A4AEA0; // same
@color_text_transport: #556872; // @color_icon_transport

@color_icon_hotels: #9575CD; // same
@color_text_hotels: #65499c; // @color_icon_hotels
@color_icon_beauty: #F48FB1; // same
@color_text_beauty: #A34669; // @color_icon_beauty

@color_icon_tint: #866E54; // same
@color_text_tint: #6D5640;
@color_icon_capital_tint: #3A3A3A; // same
@color_icon_peak: #800000;
@color_text_peak: #A52A2A;
@color_icon_volcano: @color_icon_health;
@color_text_volcano: @color_text_health;
@color_icon_mine: @color_icon_tint;
@color_text_mine: @color_text_tint;

// roads of all kinds
@color_small_road: #FEFEFE; // l: 0.4
@color_small_road_casing: #CCC; // l: 0.1
@color_pedestrian: #CCC;
@color_pedestrian_casing: #AAA;
@color_bridge: #A4A8AB; // l: 0.1
@color_railroad_tunnel: #A4A8ABAA; // l: 0.1
@color_cycleway_dashes: #6876e1; // l: 0.1
@color_footway_area: #F8F1EA; // l: 0.1
@color_footway_casing: #fefefe30;
@color_road_construction: #F7BE81; // l: 0.1
@color_dashes_casing: #FEFEFE30;
@color_track_dashes: #8C6F58; // l: 0.1
@color_track_casing: #fefefe88;
@if Style == Outdoor
    @color_footway_dashes: #AF756A; // l: 0.1
    @if SubStyle == Bike
        @color_cycleway_dashes: #5765d0; // l: 0.1
        @color_track_dashes: #474E85;
    @endif
    @color_path_dashes: @color_track_dashes;
    @color_motorway_casing: @color_small_road_casing;
    @color_motorway: @color_small_road;
    @color_trunk_casing: @color_small_road_casing;
    @color_trunk: @color_small_road;
    @color_primary_casing: @color_small_road_casing;
    @color_primary: @color_small_road;
    @color_secondary_casing: @color_small_road_casing;
    @color_secondary: @color_small_road;
    @color_tertiary: @color_small_road;
@else
    @color_footway_dashes: #B8908A; // l: 0.1
    @color_path_dashes: @color_footway_dashes;
    @color_motorway_casing: #E85; // l: 0.1
    @color_motorway: #F96; // l: 0.1
    @color_trunk_casing: #E96; // l: 0.1
    @color_trunk: #FA7; // l: 0.1
    @color_primary_casing: #EA5; // l: 0.1
    @color_primary: #FB6; // l: 0.1
    @color_secondary_casing: #EC6; // l: 0.1
    @color_secondary: #FD7; // l: 0.1
    @color_tertiary: @color_small_road;
@endif

@color_railway: #E6F8E0; // l: 0.1
@color_railway_dashes: #999; // l: 0.1
@color_railway_disused: #B8B8B8AA; // l: 0.1

@color_icon_ford: #0f7cd4;
@color_text_ford: #0267B4;
@color_icon_fountain: @color_icon_ford;

@color_rock: #a8a8a8;

// Road number shields in road sign colours: the tint colours shield.svg, the engine picks white or dark text for contrast
@color_shield_red: #C1121C; // RAL 3020 traffic red
@color_shield_green: #308446; // RAL 6024 traffic green
@color_shield_blue: #005387; // RAL 5017 traffic blue
@color_shield_yellow: #F7B500; // RAL 1023 traffic yellow
@color_shield_yellow_text: #1E1E1E;
@color_shield_white: #FEFEFE; // white plates (shield_plate.svg)
@color_shield_orange: #EE8A00; // Turkish otoyol
@color_shield_white_text: #FFFFFF;
@color_shield_gold_text: #FFC000; // Cyprus
@color_shield_uk_green: #00703C; // British and Irish primary routes: yellow numbers on green
@color_shield_uk_yellow: #FFD200;
@color_shield_plate_blue_text: #005387; // blue numbers on a white plate (Turkish provincial roads)

// Route palette for mapColor(): OSM colour names of route relations, other colours snap to the nearest entry.
// The same Material hues as the POI icons, a step stronger so lines read on the map.
@route_palette: "red:#E53935, orange:#FB8C00, yellow:#FBC02D, green:#43A047, blue:#1E88E5, purple:#8E24AA, violet:#8E24AA, brown:#8D6E63, grey:#90A4AE, gray:#90A4AE, black:#546E7A, white:#B0BEC5, pink:#EC407A";
// Translucent bands of hiking and bicycle routes under the ways: the same hues, light ones more opaque so all read alike
@route_band_palette: "red:#E5393570, orange:#FB8C0080, yellow:#FBC02DA0, green:#43A04799, blue:#1E88E570, purple:#8E24AA60, violet:#8E24AA60, brown:#8D6E6390, grey:#90A4AE90, gray:#90A4AE90, black:#546E7A90, white:#B0BEC5A0, pink:#EC407A70";
