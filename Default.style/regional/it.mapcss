// Italy. map:country is the country of the map tile (the generator stores it per tile, objects across a border carry their own).
[map:country=IT] {
    // Road numbers as on Italian signs: autostrade white on green, state, regional and provincial roads (SS, SR, SP)
    // white on blue
    |z12-[highway=secondary],
    |z14-[highway=tertiary] {
        shield-image: "shield.svg";
        shield-color: @color_shield_blue;
    }
}
