// Turkey. map:country is the country of the map tile (the generator stores it per tile, objects across a border carry their own).
[map:country=TR] {
    // Road numbers as on Turkish signs: motorways (otoyol) black on orange, state roads (D) white on blue, provincial roads
    // blue on a white plate
    |z9-[highway=motorway] {
        shield-color: @color_shield_orange;
        shield-text-color: @color_shield_yellow_text;
    }
    |z12-[highway=secondary] {
        shield-image: "shield_plate.svg";
        shield-color: @color_shield_white;
        shield-text-color: @color_shield_plate_blue_text;
    }
}
