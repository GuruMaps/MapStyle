// Switzerland. map:country is the country of the map tile (the generator stores it per tile, objects across a border carry their own).
[map:country=CH] {
    // Road numbers as on Swiss signs: motorways white on red, main roads white on blue
    |z9-[highway=motorway] {
        shield-color: @color_shield_red;
    }
    |z12-[highway=secondary],
    |z14-[highway=tertiary] {
        shield-image: "shield.svg";
        shield-color: @color_shield_blue;
    }
}
