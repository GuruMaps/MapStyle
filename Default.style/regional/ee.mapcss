// Estonia. map:country is the country of the map tile (the generator stores it per tile, objects across a border carry their own).
[map:country=EE] {
    // Road numbers as on Estonian signs: main roads white on red, secondary roads black on yellow; E-roads green
    |z9-[highway=motorway],
    |z11-([highway=trunk], [highway=primary]) {
        shield-color: @color_shield_red;
    }
}
