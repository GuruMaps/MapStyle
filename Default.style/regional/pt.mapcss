// Portugal. map:country is the country of the map tile (the generator stores it per tile, objects across a border carry their own).
[map:country=PT] {
    // Road numbers as on Portuguese signs: autoestradas white on blue, principal routes (IP) white on red
    |z9-[highway=motorway] {
        shield-color: @color_shield_blue;
    }
    |z11-([highway=trunk], [highway=primary]),
    |z12-[highway=secondary] {
        [ref^=IP] {
            shield-color: @color_shield_red;
        }
    }
}
