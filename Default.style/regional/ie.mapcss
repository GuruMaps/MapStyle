// Ireland. map:country is the country of the map tile (the generator stores it per tile, objects across a border carry their own).
[map:country=IE] {
    // Road numbers as on Irish signs: motorways white on blue, national roads (N) yellow on green, regional roads (R) black
    // on a white plate. E-road numbers are not signed, so the z8 shield shows the national number too.
    |z8([highway=motorway][int_ref], [highway=trunk][int_ref]) {
        shield-text: eval(any(listItem(tag('ref'), 0), listItem(tag('int_ref'), 0)));
    }
    |z8-[highway=motorway] {
        shield-color: @color_shield_blue;
    }
    |z8-[highway=trunk],
    |z11-[highway=primary] {
        shield-color: @color_shield_uk_green;
        shield-text-color: @color_shield_uk_yellow;
    }
    |z12-[highway=secondary] {
        shield-image: "shield_plate.svg";
        shield-color: @color_shield_white;
    }
}
