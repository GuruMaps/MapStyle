// Cyprus. map:country is the country of the map tile (the generator stores it per tile, objects across a border carry their own).
[map:country=CY] {
    // Road numbers as on Cypriot signs: gold on green for motorways, gold on blue for other roads
    |z9-[highway=motorway],
    |z11-([highway=trunk], [highway=primary]),
    |z12-[highway=secondary],
    |z14-[highway=tertiary] {
        shield-text-color: @color_shield_gold_text;
    }
    |z12-[highway=secondary],
    |z14-[highway=tertiary] {
        shield-image: "shield.svg";
        shield-color: @color_shield_blue;
    }
}
