// Czechia. map:country is the country of the map tile (the generator stores it per tile, objects across a border carry their own).
[map:country=CZ] {
    // Road numbers as on Czech signs: motorways white on red, class I and II roads white on blue; class III numbers
    // are not signed
    |z9-[highway=motorway] {
        shield-color: @color_shield_red;
    }
    |z12-[highway=secondary] {
        shield-color: @color_shield_blue;
    }
    |z14-[highway=tertiary] {
        shield-text: none;
    }
    // Prague metro: the station at z14-16 and the entrances from z17 (points.mapcss) carry the ROPID symbol in the line colour,
    // as on Legible Prague signs; without one line (an interchange) the symbol stays black. network:wikidata and colour come
    // from the metro lines (sql/5_generate_regions.sql); licence in logos/LICENSES.json
    |z14-16[railway=station][station=subway][network:wikidata=Q190271],
    node|z17-[railway=subway_entrance][network:wikidata=Q190271] {
        icon-image: "logos/metro_praha.svg";
        icon-tint: #00000000;
        [colour] {
            icon-image: "logos/metro_praha_line.svg";
            icon-tint: eval(mapColor(@route_palette, tag('colour'), #000000));
        }
    }
}
