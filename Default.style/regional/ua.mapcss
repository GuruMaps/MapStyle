// Ukraine. map:country is the country of the map tile (the generator stores it per tile, objects across a border carry their own).
[map:country=UA] {
    // Road numbers as on Ukrainian signs (5.66): international М and national Н white on red, regional Р and territorial Т
    // white on blue as in lines.mapcss, oblast О and local С on a white plate; E-roads green. Refs are Cyrillic: М-06, Н-20.
    |z11-([highway=trunk], [highway=primary]),
    |z12-[highway=secondary],
    |z14-[highway=tertiary] {
        [ref^=М], [ref^=Н] {
            shield-color: @color_shield_motorway;
        }
        [ref^=О], [ref^=С] {
            shield-image: "shield_plate.svg";
            shield-color: @color_shield_white;
        }
    }
    // Kyiv metro: the station at z14-16 and the entrances from z17 (points.mapcss) carry the green M. network:wikidata comes
    // from the metro lines (sql/5_generate_regions.sql); licence in logos/LICENSES.json
    |z14-16[railway=station][station=subway][network:wikidata=Q215871],
    node|z17-[railway=subway_entrance][network:wikidata=Q215871] {
        icon-image: "logos/metro_kyiv.svg";
        icon-tint: #00000000;
    }
}
