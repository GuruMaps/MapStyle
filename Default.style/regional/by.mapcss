// Belarus. map:country is the country of the map tile (the generator stores it per tile, objects across a border carry their own).
[map:country=BY] {
    // Road numbers as on Belarusian signs (5.29.3): magistral М and republican Р roads white on red, local Н roads on white,
    // E-roads green (e-roads.mapcss). Refs are Cyrillic without a space: М1, Р23, Н9031.
    |z9-[highway=motorway],
    |z11-([highway=trunk], [highway=primary]),
    |z12-[highway=secondary],
    |z14-[highway=tertiary] {
        // A road through a city has the passage number after a slash, М8/П7 on the streets of Gomel; signs show М8
        [ref] {
            shield-text: eval(listItem(listItem(tag('ref'), 0), 0, '/'));
        }
        [ref^=М], [ref^=Р] {
            shield-image: "shield.svg";
            shield-color: @color_shield_red;
        }
        [ref^=Н] {
            shield-image: "shield_plate.svg";
            shield-color: @color_shield_white;
        }
    }
    // Minsk metro, the only one in Belarus: the logo at z14-16 and on the entrances from z17 (points.mapcss). Its lines
    // carry no network:wikidata, so the country selects it; licence in logos/LICENSES.json
    |z14-16[railway=station][station=subway],
    node|z17-[railway=subway_entrance] {
        icon-image: "logos/metro_minsk.svg";
        icon-tint: #00000000;
    }
}
