// Germany. map:country is the country of the map tile (the generator stores it per tile, objects across a border carry their own).
[map:country=DE] {
    // Road numbers as on German signs: Autobahn white on blue (Zeichen 405), Bundesstraße black on yellow with a black
    // edge (Zeichen 401). A motorway with only an E-road number keeps the green shield of e-roads.mapcss.
    |z9-[highway=motorway][ref] {
        shield-color: @color_shield_blue;
    }
    |z11-([highway=trunk], [highway=primary]),
    |z12-[highway=secondary],
    |z14-[highway=tertiary] {
        // Landes-, Staats- and Kreisstraßen (L, S, St, K) have no number plates: a white plate, not the Autobahn blue
        [ref] {
            shield-image: "shield_plate.svg";
            shield-color: @color_shield_white;
        }
        [highway=trunk][ref^="A "] {
            shield-image: "shield.svg";
            shield-color: @color_shield_blue;
        }
        // with the space: Bavarian Kreisstraßen carry the district plate code, e.g. BA 12 in Bamberg
        [ref^="B "] {
            shield-color: @color_shield_yellow;
            shield-text-color: @color_shield_yellow_text;
        }
    }
    // U-Bahn: the national white U on blue (Munich's shade) at z14-16 and on the entrances from z17 (points.mapcss).
    // Stadtbahn stops signed with the U are mostly station=light_rail in OSM and keep the railway symbol.
    |z14-16[railway=station][station=subway],
    node|z17-[railway=subway_entrance] {
        icon-image: "logos/metro_ubahn.svg";
        icon-tint: #0065AE;
    }
}
