// Romania. map:country is the country of the map tile (the generator stores it per tile, objects across a border carry their own).
[map:country=RO] {
    // Road numbers as on Romanian signs: motorways white on green, national roads (DN) white on red, county roads (DJ) white
    // on blue
    |z11-([highway=trunk], [highway=primary]),
    |z12-[highway=secondary],
    |z14-[highway=tertiary] {
        [ref^=DN] {
            shield-image: "shield.svg";
            shield-color: @color_shield_red;
        }
        [ref^=DJ] {
            shield-image: "shield.svg";
            shield-color: @color_shield_blue;
        }
    }
}
