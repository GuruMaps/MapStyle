// Latvia. map:country is the country of the map tile (the generator stores it per tile, objects across a border carry their own).
[map:country=LV] {
    // Road numbers as on Latvian signs: main roads (A) white on red, regional roads (P) white on blue, local roads (V) on a
    // white plate; E-roads green
    |z9-[highway=motorway],
    |z11-([highway=trunk], [highway=primary]),
    |z12-[highway=secondary],
    |z14-[highway=tertiary] {
        [ref^=A] {
            shield-image: "shield.svg";
            shield-color: @color_shield_red;
        }
        [ref^=P] {
            shield-image: "shield.svg";
            shield-color: @color_shield_blue;
        }
        [ref^=V] {
            shield-image: "shield_plate.svg";
            shield-color: @color_shield_white;
        }
    }
}
