// Slovakia. map:country is the country of the map tile (the generator stores it per tile, objects across a border carry their own).
[map:country=SK] {
    // Road numbers as on Slovak signs: motorways and expressways white on red, class I and II roads white on blue, class III
    // roads on a white plate
    |z9-[highway=motorway] {
        shield-color: @color_shield_red;
    }
    |z12-[highway=secondary] {
        shield-color: @color_shield_blue;
    }
}
