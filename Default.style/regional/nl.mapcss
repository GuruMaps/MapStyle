// Netherlands. map:country is the country of the map tile (the generator stores it per tile, objects across a border carry their own).
[map:country=NL] {
    // Road numbers as on Dutch signs: A roads white on red, N roads black on yellow, city ring S roads black on a white plate;
    // E-roads green
    |z9-[highway=motorway],
    |z11-([highway=trunk], [highway=primary]),
    |z12-[highway=secondary],
    |z14-[highway=tertiary] {
        [ref^=A] {
            shield-image: "shield.svg";
            shield-color: @color_shield_red;
        }
        [ref^=N] {
            shield-image: "shield.svg";
            shield-color: @color_shield_yellow;
        }
        [ref^=S] {
            shield-image: "shield_plate.svg";
            shield-color: @color_shield_white;
        }
    }
}
