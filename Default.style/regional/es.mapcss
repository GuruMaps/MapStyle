// Spain. map:country is the country of the map tile (the generator stores it per tile, objects across a border carry their own).
[map:country=ES] {
    // Road numbers as on Spanish signs: autopistas and autovías white on blue, national roads (N) white on red; regional roads
    // differ by region and keep the yellow of lines.mapcss
    |z9-[highway=motorway] {
        shield-color: @color_shield_blue;
    }
    |z11-([highway=trunk], [highway=primary]),
    |z12-[highway=secondary],
    |z14-[highway=tertiary] {
        [ref^="N-"] {
            shield-image: "shield.svg";
            shield-color: @color_shield_red;
        }
    }
}
