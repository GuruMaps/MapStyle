// France. map:country is the country of the map tile (the generator stores it per tile, objects across a border carry their own).
[map:country=FR] {
    // Road numbers as on French signs: autoroutes and routes nationales white on red, routes départementales black on
    // yellow; E-roads green
    |z9-[highway=motorway],
    |z11-([highway=trunk], [highway=primary]),
    |z12-[highway=secondary],
    |z14-[highway=tertiary] {
        [ref^="A "], [ref^="N "] {
            shield-image: "shield.svg";
            shield-color: @color_shield_red;
        }
        [ref^="D "] {
            shield-image: "shield.svg";
            shield-color: @color_shield_yellow;
        }
    }
}
