// Poland. map:country is the country of the map tile (the generator stores it per tile, objects across a border carry their own).
[map:country=PL] {
    // Road numbers as on Polish signs: national roads (DK), expressways and motorways red, voivodeship roads (DW) yellow
    |z9-[highway=motorway],
    |z11-([highway=trunk], [highway=primary]) {
        shield-color: @color_shield_red;
    }
    |z12-[highway=secondary] {
        shield-color: @color_shield_yellow;
        shield-text-color: @color_shield_yellow_text;
    }
    // county and commune numbers (2903D, 120613D) are not signposted
    |z14-[highway=tertiary] {
        shield-text: none;
    }
    // Warsaw metro: the station at z14-16 and the entrances from z17 (points.mapcss) carry the Warsaw Metro logo.
    // network:wikidata comes from the metro lines (sql/5_generate_regions.sql); licence in logos/LICENSES.json
    |z14-16[railway=station][station=subway][network:wikidata=Q11777882],
    node|z17-[railway=subway_entrance][network:wikidata=Q11777882] {
        icon-image: "logos/metro_warszawa.svg";
        icon-tint: #00000000;
    }
}
