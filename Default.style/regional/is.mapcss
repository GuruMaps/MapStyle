// Iceland. map:country is the country of the map tile (the generator stores it per tile, objects across a border carry their own).
[map:country=IS] {
    // Road numbers as on Icelandic signs: black on a white plate
    |z9-[highway=motorway],
    |z11-([highway=trunk], [highway=primary]),
    |z12-[highway=secondary],
    |z14-[highway=tertiary] {
        shield-image: "shield_plate.svg";
        shield-color: @color_shield_white;
    }
}
