// Moldova. map:country is the country of the map tile (the generator stores it per tile, objects across a border carry their own).
[map:country=MD] {
    // Road numbers as on Moldovan signs: national roads (M) white on red; E-roads green
    |z9-[highway=motorway],
    |z11-([highway=trunk], [highway=primary]) {
        [ref^=M] {
            shield-color: @color_shield_red;
        }
    }
}
