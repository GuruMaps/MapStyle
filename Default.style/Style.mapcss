@if Theme == Dark
    @import "colors_dark.mapcss";
    @image_noData: "noData_dark.svg";
    @image_forbidden_area: "forbidden_area_dark.svg";
    @image_wood: "wood_dark.svg";
    @image_wood_by_leaf_type: "broadleaved:wood_broadleaved_dark.svg, needleleaved:wood_needleleaved_dark.svg, mixed:wood_mixed_dark.svg, leafless:wood_leafless_dark.svg";
    @image_garden: "garden_dark.svg";
    @image_scrub: "scrub_dark.svg";
    @image_vineyard: "vineyard_dark.svg";
    @image_orchard: "orchard_dark.svg";
    @image_plant_nursery: "plant_nursery_dark.svg";
    @image_allotments: "allotments_dark.svg";
    @image_quarry: "quarry_dark.svg";
    @image_dog_park: "dog_park_dark.svg";
    @intermittent_water: "intermittent_water_dark.svg";
@else // Default colors
    @import "colors.mapcss";
    @image_noData: "noData.svg";
    @image_forbidden_area: "forbidden_area.svg";
    @image_wood: "wood.svg";
    @image_wood_by_leaf_type: "broadleaved:wood_broadleaved.svg, needleleaved:wood_needleleaved.svg, mixed:wood_mixed.svg, leafless:wood_leafless.svg";
    @image_garden: "garden.svg";
    @image_scrub: "scrub.svg";
    @image_vineyard: "vineyard.svg";
    @image_orchard: "orchard.svg";
    @image_plant_nursery: "plant_nursery.svg";
    @image_allotments: "allotments.svg";
    @image_quarry: "quarry.svg";
    @image_dog_park: "dog_park.svg";
    @intermittent_water: "intermittent_water.svg";
@endif
@image_wetland: "wetland.svg";

// canvas color
canvas
{
    fill-color: @color_ground;
    fill-image: @image_noData;
}

// for any object with tag 'layer', set it's property 'layer', to value of 'layer' tag
*|z9-[layer]
{
    layer: eval(tag(layer));
}

@import "polygons.mapcss";
@import "lines.mapcss";
@import "points.mapcss";
@import "relations.mapcss";

// Regional rules: road number colours and metro entrances of one country, tested with map:country
@import "regional/al.mapcss";
@import "regional/at.mapcss";
@import "regional/be.mapcss";
@import "regional/by.mapcss";
@import "regional/ch.mapcss";
@import "regional/cy.mapcss";
@import "regional/cz.mapcss";
@import "regional/de.mapcss";
@import "regional/dk.mapcss";
@import "regional/ee.mapcss";
@import "regional/es.mapcss";
@import "regional/fi.mapcss";
@import "regional/fr.mapcss";
@import "regional/gb.mapcss";
@import "regional/hr.mapcss";
@import "regional/hu.mapcss";
@import "regional/ie.mapcss";
@import "regional/is.mapcss";
@import "regional/it.mapcss";
@import "regional/lt.mapcss";
@import "regional/lu.mapcss";
@import "regional/lv.mapcss";
@import "regional/md.mapcss";
@import "regional/nl.mapcss";
@import "regional/no.mapcss";
@import "regional/pl.mapcss";
@import "regional/pt.mapcss";
@import "regional/ro.mapcss";
@import "regional/rs.mapcss";
