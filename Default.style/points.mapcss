// DefaultStyle from GLMap.framework
// Copyright (c) 2013-2019 Evgen Bodunov. All rights reserved.

/******************************* Points *******************************/

node,area {
    // Параметры текста по умолчанию, чтоб не дублировать
    // Names without a size of their own, POIs and the like, grow slowly from z15
    font-size: eval(zlinear(15, 10, 10.4, 10.8, 11.1, 11.4));
    font-weight: medium;
    font-stroke-width: 1pt;
    font-stroke-color: @color_label_stroke;

    // Area names: capitals with letter spacing, lighter than settlements. 'el' drops accents
    // from Greek capitals; other scripts follow root rules, not the device locale.
    // Countries, regions and seas appear set tight with a thinner halo, and grow and spread out as the map zooms in
    [place=country] {
        // A country is named once it is about 45 pt across on the screen. polySize is the size of the country under the label
        // in km (Web Mercator, added by the world map generator); maps without it name every country from z2
        |z2-8[!polySize],
        |z2-8[polySize>=1400],
        |z3-8[polySize>=700],
        |z4-8[polySize>=350],
        |z5-8[polySize>=175],
        |z6-8[polySize>=90],
        |z7-8[polySize>=45],
        |z8 {
            text: eval(uppercase(locTag('name'), 'el'));
            text-color: @color_name_text;
            font-size: eval(zlinear(2, 10.9, 11.6, 12.3, 13, 13.8, 14.6, 15.5));
            font-weight: normal;
            text-letter-spacing: eval(zlinear(2, 0.05, 0.08, 0.11, 0.14, 0.17, 0.21, 0.25));
            font-stroke-width: eval(zlinear(2, 1.5pt, 1.75pt, 2pt));
            text-priority: 10;
        }
        // A country twice as big gets a visibly bigger name, 2 pt among the big ones, and is spaced and haloed like the smaller one a
        // zoom later; small countries appear at 10-12 pt, every name grows 0.8 pt a zoom. Each size ladder ends at z8, so a bigger
        // country also wins the label collisions
        [polySize>=1400] {
            font-size: eval(zlinear(2, 13, 13.8, 14.6, 15.4, 16.2, 17, 17.8));
        }
        [polySize>=2800] {
            font-size: eval(zlinear(2, 15, 15.8, 16.6, 17.4, 18.2, 19, 19.8));
            text-letter-spacing: eval(zlinear(1, 0.05, 0.08, 0.11, 0.14, 0.17, 0.21, 0.25, 0.28));
            font-stroke-width: eval(zlinear(1, 1.5pt, 1.75pt, 2pt));
        }
        [polySize>=5600] {
            font-size: eval(zlinear(2, 17, 17.8, 18.6, 19.4, 20.2, 21, 21.8));
            text-letter-spacing: eval(zlinear(0, 0.05, 0.08, 0.11, 0.14, 0.17, 0.21, 0.25, 0.28, 0.31));
            font-stroke-width: eval(zlinear(0, 1.5pt, 1.75pt, 2pt));
        }
        [polySize<1400] {
            font-size: eval(zlinear(3, 12, 12.8, 13.6, 14.4, 15.2, 16));
            text-letter-spacing: eval(zlinear(3, 0.05, 0.08, 0.11, 0.14, 0.17, 0.21));
            font-stroke-width: eval(zlinear(3, 1.5pt, 1.75pt, 2pt));
        }
        [polySize<700] {
            font-size: eval(zlinear(4, 11.5, 12.3, 13.1, 13.9, 14.7));
            text-letter-spacing: eval(zlinear(4, 0.05, 0.08, 0.11, 0.14, 0.17));
            font-stroke-width: eval(zlinear(4, 1.5pt, 1.75pt, 2pt));
        }
        [polySize<350] {
            font-size: eval(zlinear(5, 11.1, 11.9, 12.7, 13.5));
            text-letter-spacing: eval(zlinear(5, 0.05, 0.08, 0.11, 0.14));
            font-stroke-width: eval(zlinear(5, 1.5pt, 1.75pt, 2pt));
        }
        [polySize<175] {
            font-size: eval(zlinear(6, 10.7, 11.5, 12.3));
            text-letter-spacing: eval(zlinear(6, 0.05, 0.08, 0.11));
            font-stroke-width: eval(zlinear(6, 1.5pt, 1.75pt, 2pt));
        }
        [polySize<90] {
            font-size: eval(zlinear(7, 10.3, 11.1));
            text-letter-spacing: eval(zlinear(7, 0.05, 0.08));
            font-stroke-width: eval(zlinear(7, 1.5pt, 1.75pt));
        }
        [polySize<45] {
            font-size: 10;
            text-letter-spacing: 0.05;
            font-stroke-width: 1.5pt;
        }
    }

    // Regions rank below cities: they are background
    [boundary=administrative] {
        |z6-8[admin_level=3],
        |z6-8[admin_level=4] {
            text: eval(uppercase(locTag('name'), 'el'));
            text-color: @color_region_text;
            font-size: eval(zlinear(6, 10.5, 11.2, 11.9));
            font-weight: light;
            text-letter-spacing: eval(zlinear(6, 0.1, 0.18, 0.25));
            font-stroke-width: eval(zlinear(6, 2.5pt, 3pt));
            text-priority: 5;
            text-big-padding: true;
            [admin_level=3] { font-size: eval(zlinear(6, 11.5, 12.2, 12.9)); }
        }
    }

    [place=city] {
        |z6-[population>250000],
        |z7-[population>100000],
        |z8-[population>50000],
        |z9-{
            text: eval(locTag('name'));
            text-color: @color_label_text;
            // 11 at z6, 13 at z10, 14.4 at z12, then slower up to 15.9 at z16
            font-size: eval(zlinear(6, 11, 11.5, 12, 12.5, 13.2, 13.8, 14.4, 14.9, 15.3, 15.6, 15.9));
            font-weight: semibold;
            font-stroke-width: 3pt;
            // A city that is also a region is named on its boundary like on its node, without the spacing of region names
            text-letter-spacing: 0;
            text-priority: 7;
            text-big-padding: true;
            // A dot pins the city on country-scale maps; from z10 the name lies on the city itself
            |z6-9 {
                // White dot with a dark ring, smaller than the solid capital dot
                icon-image: "poi_city_dot.svg";
                icon-scale: 0.8;
                icon-tint: @color_icon_capital_tint;
                font-weight: medium;
                text-big-padding: false;
                [population>400000] {
                    font-weight: semibold;
                }
            }
            [population>400000] {
                font-size: eval(zlinear(6, 12, 12.5, 13, 13.5, 14.2, 14.8, 15.4, 15.9, 16.3, 16.6, 16.9));
            }
            // Cities over a million follow the capital from z9; z13+ tiles carry population but not capital
            [population>1000000] {
                font-size: eval(zlinear(6, 12.3, 12.9, 13.4, 14, 15, 16, 17, 18, 18.3, 18.6, 18.9));
            }
        }
    }

    // Settlement rank by size and weight, all growing with the zoom: city 11-13 medium with a dot, then 13-16 semibold; town 11-14.5
    // medium, village 10-13, hamlet 9-11.5. A class shows up quiet, grey with a halo that thickens over its first zoom, and gets its
    // full colour one zoom later
    |z9-[place=town],
    |z11-[place=village],
    |z12-[place=hamlet] {
        text: eval(locTag('name'));
        text-color: @color_label_text;
        font-size: eval(zlinear(11, 10.3, 10.8, 11.3, 11.8, 12.3, 12.6, 12.9));
        font-weight: normal;
        font-stroke-width: eval(zlinear(11, 1.5pt, 2pt));
        text-priority: 6;
        text-big-padding: true;
        [place=town] {
            font-size: eval(zlinear(9, 11.2, 11.8, 12.4, 13, 13.5, 13.9, 14.2, 14.5));
            font-weight: medium;
            font-stroke-width: eval(zlinear(9, 1.5pt, 2pt));
        }
        [place=hamlet] {
            font-size: eval(zlinear(12, 9.3, 9.8, 10.3, 10.8, 11.2, 11.5));
            font-stroke-width: eval(zlinear(12, 1.5pt, 2pt));
        }
        |z9[place=town],
        |z11[place=village],
        |z12[place=hamlet] {
            text-color: @color_label_new_text;
        }
    }
    
    |z14-[place=isolated_dwelling],
    |z14-[place=farm] {
        text: eval(locTag('name'));
        text-color: @color_label_text;
        font-size: eval(zlinear(14, 8.6, 9, 9.4, 9.8, 10.1));
        font-weight: normal;
        font-stroke-width: eval(zlinear(14, 1.5pt, 2pt));
        text-priority: 4;
        |z14 {
            text-color: @color_label_new_text;
        }
    }

    // The capital grows with the zoom: 12 at z6, 14 at z9, 18 at z13, then slowly. A boundary's admin_level is its own level: a
    // capital that is also a region, as Minsk or Prague, is named on its boundary like on its node
    |z5-14[capital=yes] {
        [admin_level=2], [!admin_level], [boundary=administrative] {
            |z5-9 {
                icon-image: "poi_circle_small.svg";
                icon-scale: 1.2;
                icon-tint: @color_icon_capital_tint;
            }

            text: eval(locTag('name'));
            text-color: @color_label_text;
            font-size: eval(zlinear(5, 11.4, 12, 12.6, 13.3, 14, 15, 16, 17, 18, 18.3, 18.6, 18.9));
            font-weight: semibold;
            font-stroke-width: 3pt;
            text-letter-spacing: 0;

            text-priority: 9;
            text-big-padding: false;
        }
    }

    // Названия районов
    |z12-[place=suburb] {
        |z12-13 {
            text-big-padding: true;
        }
        text: eval(uppercase(locTag('name'), 'el'));
        text-color: @color_suburb_text;
        text-priority: 3;
        font-size: eval(zlinear(12, 10, 10.9, 11.7, 12.3, 12.8, 13.2));
        font-stroke-width: 1.5pt;
        text-letter-spacing: eval(zlinear(12, 0.08, 0.1, 0.12, 0.14, 0.15, 0.16));
    }
    
    // Названия микрорайонов
    |z14-[place=quarter] {
        text: eval(uppercase(locTag('name'), 'el'));
        text-color: @color_quarter_text;
        text-priority: 2;
        font-size: eval(zlinear(14, 9, 9.6, 10.1, 10.6, 11));
        font-weight: normal;
        font-stroke-width: 1.5pt;
        text-letter-spacing: eval(zlinear(14, 0.06, 0.08, 0.1, 0.11, 0.12));
    }

    // City names keep their size and from z14 yield to districts, streets and POIs
    |z14-15[place=city] {
        text-priority: 2;
    }

    // Снимаем приоритет имен населенных пунктов, когда мы уже хорошо видим дома
    |z16-[place]{
        text-priority: -10;
    }

    // Названия больших объектов
    |z16-{
        @if SubStyle != Car
            area(
                [highway=pedestrian],
                [highway=footway]
            ),
        @endif
        @if Style == Outdoor
            [place=locality],
        @endif
        [place=square],
        {
            text: eval(locTag('name'));
            text-color: @color_suburb_text;
            text-priority: 1;
        }
    }
    @if Sport
        |z16-[leisure=stadium] {
            text: eval(locTag('name'));
            text-color: @color_label_text;
        }
    @endif

    // Название воды
    node{
        |z1-8[place=ocean],
        |z6-8[place=sea]
        {
            text: eval(uppercase(locTag('name'), 'el'));
            text-color: @color_water_text;
            text-priority: 5;
            font-size: 13;
            font-style: italic;
            text-letter-spacing: 0.25;
            font-stroke-color: @color_water;
            font-stroke-width: 3pt;
        }

        |z1-8[place=ocean] {
            text-letter-spacing: eval(zlinear(1, 0.12, 0.15, 0.18, 0.21, 0.24, 0.26, 0.28, 0.3));
            font-stroke-width: eval(zlinear(1, 2pt, 2.25pt, 2.5pt, 2.75pt, 3pt));
            font-size: eval(zlinear(1, 12, 12.7, 13.4, 14.1, 14.8, 15.5, 16.2, 16.9));
        }
        |z6-8[place=sea] {
            text-letter-spacing: eval(zlinear(6, 0.12, 0.18, 0.25));
            font-stroke-width: eval(zlinear(6, 2pt, 3pt));
            font-size: eval(zlinear(6, 12.3, 13, 13.8));
        }
    }

    |z9-{
        area[natural=water],
        [natural=bay],
        area[landuse=basin],
        [landuse=reservoir] {
            // Halo in the water colour: a white one washes the thin italic out on blue
            text-color: @color_water_text;
            font-stroke-color: @color_water;
            font-stroke-width: 2pt;
            font-style: italic;
        }
    }

    area|z13-[landuse=residential] {
        text-color: @color_landuse_residential_text;
    }

    area|z13-[natural=wetland] {
        text-color: @color_wetland_text;
        font-style: italic;
        font-stroke-color: @color_wetland_stroke;
        font-stroke-width: 1.5pt;
    }

    |z9-[place=island],
    |z13-[place=islet] {
        text-color: @color_national_park_text;
    }

    area|z9-{
        [boundary=protected_area],
        [boundary=national_park],
        [leisure=nature_reserve],
        |z13-(
            [leisure=park],
            [leisure=garden]
        ) {
            text-color: @color_national_park_text;
            font-stroke-width:2pt;
            font-stroke-color: @color_wood;
        }
        [boundary=protected_area],
        [boundary=national_park],
        [leisure=nature_reserve] {
            font-style: italic;
        }
    }

    |z13-[landuse=allotments] {
        text-color: @color_allotments_text;
        font-stroke-width:2pt;
        font-stroke-color: @color_allotments;
    }

    area|z9-{
        [boundary=national_park],
        [boundary=protected_area],
        [landuse=basin],
        [landuse=reservoir],
        [leisure=nature_reserve],
        [natural=bay],
        [natural=water],
        [place=island],
        |z13-(
            [leisure=garden],
            [leisure=park],
            [landuse=allotments],
            [landuse=residential],
            [landuse=salt_pond],
            [natural=beach], 
            [natural=sand],
            [natural=wetland],
            [place=islet]
        ) {
            // текст пишем для объекта на масштабе polyZoom + 5
            // Area names rank below settlements: a big park must not hide the town inside it
            font-weight: normal;
            
            // тут надо еще подумать. крупные объекты - можно было бы показывать на карте мира.
            // но это замедлит ее генерацию
            |z9-[polyZoom<=3] {
                text: eval(locTag('name'));
                text-priority: 5;
                font-size: eval(zlinear(9, 9, 9.6, 10.2, 10.8, 11.3, 11.8, 12.2));
            }
            |z9-[polyZoom=4] {
                text: eval(locTag('name'));
                text-priority: 4;
                font-size: eval(zlinear(9, 8, 8.6, 9.2, 9.8, 10.3, 10.8, 11.2));
            }
            |z10-[polyZoom=5] {
                text: eval(locTag('name'));
                text-priority: 3;
                font-size: eval(zlinear(10, 8, 8.6, 9.2, 9.8, 10.3, 10.8, 11.2));
            }
            |z11-[polyZoom=6] {
                text: eval(locTag('name'));
                text-priority: 2;
                font-size: eval(zlinear(11, 8, 8.6, 9.2, 9.8, 10.3, 10.8, 11.2));
            }
            |z12-[polyZoom=7] {
                text: eval(locTag('name'));
                text-priority: 1;
                font-size: eval(zlinear(12, 8, 8.6, 9.2, 9.8, 10.3, 10.8, 11.2));
            }
            |z13-[polyZoom=8] {
                text: eval(locTag('name'));
                text-priority: 0;
                font-size: eval(zlinear(13, 8, 8.6, 9.2, 9.8, 10.3, 10.8, 11.2));
            }
            |z14-[polyZoom=9] {
                text: eval(locTag('name'));
                text-priority: -1;
                font-size: eval(zlinear(14, 8, 8.6, 9.2, 9.8, 10.3, 10.8, 11.2));
            }
            |z15-[polyZoom=10] {
                text: eval(locTag('name'));
                text-priority: -2;
                font-size: eval(zlinear(15, 8, 8.6, 9.2, 9.8, 10.3, 10.8, 11.2));
            }
            |z16-[polyZoom=11] {
                text: eval(locTag('name'));
                text-priority: -3;
                font-size: eval(zlinear(16, 8, 8.6, 9.2, 9.8));
            }
            |z17-[polyZoom=12] {
                text: eval(locTag('name'));
                text-priority: -4;
                font-size: eval(zlinear(17, 8, 8.6, 9.2, 9.8));
            }
        }
    }

    // for nodes similar to polyZoom 9. TODO: use macros to avoid copy-paste?
    node|z14- {
        [natural=bay] {
            text: eval(locTag('name'));
            text-priority: -1;
            font-size: eval(zlinear(14, 8, 8.6, 9.2, 9.8, 10.3, 10.8, 11.2));
        }
    }

    @if BuildingName
        area|z17-[building],
        |z17-[landuse=construction]
        {
            text: eval(
                cond(
                    tag('addr:housenumber'),
                    tag('addr:housenumber') .
                    cond(
                        tag('addr:unit'),
                        ' ' . tag('addr:unit'),
                        ''
                    ) .
                    cond(
                        any(locTag('name'), tag('addr:housename')),
                        ' (' . any(locTag('name'), tag('addr:housename')) . ')',
                        ''
                    ),
                    any(locTag('name'), tag('addr:housename'))
                )
            );

            text-color: @color_building_text;
            font-size: eval(zlinear(17, 9, 9.5, 10, 10.4));
            font-stroke-width: 0.8pt;
            font-stroke-color: @color_label_stroke;
            text-priority: 1;
        }

        // имена кварталов
        // пример: https://www.openstreetmap.org/way/175502200
        |z17-[place=city_block] {
            text: eval(locTag('name'));
            text-color: @color_building_text;
            font-size: eval(zlinear(17, 10, 10.5, 11, 11.4));
            font-stroke-width: 0.8pt;
            text-priority: 2;
        }

        // для точек номер дома не так важен. Если есть имя - пишем имя.
        node|z18-(
            [addr:housenumber],
            [addr:housename]
        ) {
            text: eval( cond( locTag('name'), // write name if we have one
                              locTag('name'),
                              cond( tag('addr:housenumber'), // if we have housenumber, use it
                                    tag('addr:housenumber') . cond( tag('addr:housename'),' (' . tag('addr:housename') . ')',''),
                                    tag('addr:housename') ) ) );
            text-color: @color_building_text;
            font-size: eval(zlinear(18, 9, 9.5, 10));
            font-stroke-width: 0.8pt;
            text-priority: 1;
        }

        node|z17-[entrance][!indoor] {
            icon-image: "poi_circle_small.svg";
            icon-tint: @color_entrance_text;
            text-priority: -5;

            icon-scale: 0.7;
            [entrance=main] {
                icon-scale: 0.85;
            }

            |z18-{
                icon-image: "poi_entrance.svg";
                icon-scale: 0.8;
                [entrance=main] {
                    icon-scale: 1;
                }

                [addr:housenumber] {
                    text: eval( tag('addr:housenumber') );
                    text-color: @color_building_text;
                    font-size: eval(zlinear(18, 9, 9.5, 10));
                }

                [ref] {
                    text: eval( tag('ref') );
                    text-color: @color_entrance_text;
                    font-size: eval(zlinear(18, 8, 8.5, 9));
                }
            }
        }
    @endif


    |z16-{
        [waterway=dock], // dock бывает отмечен дополнительно как building
        [man_made=pier],
        [man_made=groyne] {
            text: eval(locTag('name'));
            text-color: @color_building_text;
            font-size: eval(zlinear(16, 11.5, 12, 12.5, 12.9, 13.2));
            font-stroke-width:2pt;
            font-stroke-color: @color_ground;
        }
    }

    |z15-[amenity=hunting_stand] {
        icon-image: "poi_hunting_stand.svg";
        icon-tint: @color_hunting_stand;
        details-enabled: false;
    }

    |z16-[man_made=water_tower] {
        icon-image: "poi_water_tower.svg";
        icon-tint: @color_hunting_stand;
        details-enabled: false;
    }

    @if AllShops
        // all kinds of shops
        |z17-[shop]{
            icon-image: "poi_circle.svg";
            icon-tint: @color_icon_stores;

            text: eval(locTag('name'));
            text-color: @color_text_stores;

            text-priority:-1;
        }
    @endif

    @if Bar
        |z15-{
            [amenity=bar] {
                icon-image:"poi_bar.svg";
                icon-tint: @color_icon_food;
                |z17-{
                    text: eval(locTag('name'));
                    text-color: @color_text_food;
                }
            }
            [amenity=pub] {
                icon-image:"poi_pub.svg";
                icon-tint: @color_icon_food;
                |z17-{
                    text: eval(locTag('name'));
                    text-color: @color_text_food;
                }
            }
        }
    @endif

    @if Food
        |z15-{
            [amenity=fast_food] {
                icon-image:"poi_fast_food.svg";
                icon-tint: @color_icon_food;
                |z17-{
                    text: eval(locTag('name'));
                    text-color: @color_text_food;
                }
            }

            [amenity=cafe] {
                icon-image:"poi_cafe.svg";
                icon-tint: @color_icon_food;
                |z17-{
                    text: eval(locTag('name'));
                    text-color: @color_text_food;
                }
            }

            [amenity=restaurant] {
                icon-image:"poi_restaurant.svg";
                icon-tint: @color_icon_food;
                |z17-{
                    text: eval(locTag('name'));
                    text-color: @color_text_food;
                }
            }
        }
    @endif

    @if Entertaiment
        |z16-[amenity=nightclub] {
            icon-image:"poi_disco.svg";
            icon-tint: @color_icon_food;
            |z17-{
                text: eval(locTag('name'));
                text-color: @color_text_food;
            }
        }
    @endif

    @if Medical
        |z15-{
            [amenity=hospital],
            [building=hospital],
            [amenity=clinic],
            [amenity=doctors] {
                icon-image:"poi_health.svg";
                icon-tint: @color_icon_health;
                |z16-{
                    text: eval(locTag('name'));
                    text-color: @color_text_health;
                }
            }
            [amenity=veterinary] {
                icon-image:"poi_vet.svg";
                icon-tint: @color_icon_health;
                |z17-{
                    text: eval(locTag('name'));
                    text-color: @color_text_health;
                }
            }
        }
        |z17-{
            [emergency=defibrillator]{
                icon-image:"poi_defibrillator.svg";
                icon-tint: @color_icon_health;
            }
            [healthcare=laboratory] {
                icon-image:"poi_laboratory.svg";
